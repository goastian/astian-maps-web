NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# Public origin used by HTTPS App Links and shared routes.
NEXT_PUBLIC_MAPS_WEB_URL=https://maps.astian.org
# Comma-separated SHA-256 fingerprints for every Android release certificate.
# Keep this empty locally; the association endpoint responds 503 until a real
# release fingerprint is configured, avoiding a false verified-link claim.
ASTIAN_ANDROID_SHA256_CERT_FINGERPRINTS=
ASTIAN_ANDROID_PACKAGE_NAME=org.astian.suite.maps
# Optional. Uses /map-styles/{theme}.json by default.
NEXT_PUBLIC_MAP_STYLE_URL=
# Evaluation-only layers are never enabled in production. For a local licence
# review, opt in explicitly and provide every source you intend to exercise.
NEXT_PUBLIC_ENABLE_EVALUATION_LAYERS=false
# Development-only escape hatch. NODE_ENV=production rejects it even if true.
NEXT_PUBLIC_SATELLITE_TILE_URL=
NEXT_PUBLIC_SATELLITE_LABEL_TILE_URL=
NEXT_PUBLIC_TERRAIN_DEM_TILE_URL=
NEXT_PUBLIC_CYCLING_TILE_URL=
# Server-side Martin origin used by the /tiles proxy.
ASTIAN_TILE_SERVER_URL=http://localhost:3001
# Local label overlay for the evaluation satellite base. Optional attribution
# HTML replaces the default OpenStreetMap credit for that overlay.
NEXT_PUBLIC_SATELLITE_LABEL_ATTRIBUTION=
# Worldwide tiles for local work only: serve the community planet (OurMap with an
# OpenFreeMap fallback) through /tiles/planet.json instead of the regional Martin
# extract. A production Next.js process ignores both switches.
ASTIAN_ENABLE_COMMUNITY_TILES=true
ASTIAN_WORLD_TILES=community
# Optional initial camera as latitude,longitude,zoom.
NEXT_PUBLIC_MAP_START=
